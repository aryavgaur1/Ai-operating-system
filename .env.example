# Local environment variables for Enterprise AI OS.
# Copy this file to .env and keep the real .env file private.

# LLM provider: 'anthropic', 'openai', or 'mock'
LLM_PROVIDER=mock

# Replace with your real Anthropic / Claude key when using Anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Replace with your real OpenAI key when using OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# API endpoint used by the web app.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional, if you want to use a real Postgres-backed store.
DATABASE_URL=postgresql://user:password@localhost:5432/enterprise_ai_os

# API port.
PORT=4000

# Connector modes — per-tool overrides win over CONNECTORS_MODE.
CONNECTORS_MODE=mock
NOTION_MODE=mock
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Slack live integration (set SLACK_MODE=live and fill credentials)
SLACK_MODE=mock
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_VERIFICATION_TOKEN=
# Optional fallback when the bot cannot list channels (missing channels:read)
SLACK_DEFAULT_CHANNEL_ID=
