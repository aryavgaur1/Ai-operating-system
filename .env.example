# Local environment variables for Enterprise AI OS / Nexora SaaS.
# Copy this file to .env and keep the real .env file private.

SAAS_MODE=true
# Investor / pre-multi-tenant demo: set SAAS_MODE=false and NEXT_PUBLIC_DEMO_MODE=true
# to use shared .env Slack/Notion tokens like the original live demo.
NEXT_PUBLIC_DEMO_MODE=false
WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=4000

# LLM
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_ai_os

# Auth / security
JWT_SECRET=replace-with-a-long-random-string
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-hex-key-min

# Email (Gmail app password). If unset, emails log to console.
EMAIL_USER=
EMAIL_PASS=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Slack (per-user OAuth + optional platform bot)
SLACK_MODE=live
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_OAUTH_REDIRECT_URI=http://localhost:4000/oauth/slack/callback
SLACK_VERIFICATION_TOKEN=
SLACK_DEFAULT_CHANNEL_ID=

# Notion
NOTION_MODE=live
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://localhost:4000/oauth/notion/callback

# Admin seed (used by npm run db:seed-admin)
ADMIN_SEED_EMAIL=aryavgaur1@gmail.com
ADMIN_SEED_PASSWORD=
