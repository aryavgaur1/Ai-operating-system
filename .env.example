# Local environment variables for Enterprise AI OS / Nexora SaaS.
# Copy this file to .env and keep the real .env file private.

# Production (Vercel web + Railway API)
# WEB_APP_URL=https://your-app.vercel.app
# NEXT_PUBLIC_API_URL=https://your-api.up.railway.app
# CORS_ORIGINS=https://your-app.vercel.app
# GOOGLE_OAUTH_REDIRECT_URI=https://your-api.up.railway.app/auth/google/callback
# NOTION_OAUTH_REDIRECT_URI=https://your-api.up.railway.app/oauth/notion/callback
# SLACK_OAUTH_REDIRECT_URI=https://your-api.up.railway.app/oauth/slack/callback
# See DEPLOY.md for full Vercel + Railway steps.

SAAS_MODE=true
# Admin / your machine: SAAS_MODE=false → always use .env Slack/Notion (unchanged).
# Customers / production: SAAS_MODE=true → per-user OAuth only (never falls back to .env).
# Investor demo UI: NEXT_PUBLIC_DEMO_MODE=true with SAAS_MODE=false.
# Local SaaS testing with EMAIL_USER set: AUTO_VERIFY_SIGNUP=true skips email gate so Connect works.
AUTO_VERIFY_SIGNUP=false
NEXT_PUBLIC_DEMO_MODE=false
WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=
PORT=4000

# LLM
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
# Marketing chatbot RAG embeddings (mock = local hash vectors; openai = text-embedding-3-small)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
# Set LLM_PROVIDER=anthropic|openai|google for richer assistant answers
# Optional live web search (omit = honest "not configured")
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
TAVILY_API_KEY=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_ai_os

# Auth / security
JWT_SECRET=replace-with-a-long-random-string
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-hex-key-min

# Email (Gmail app password). If unset, emails log to console.
EMAIL_USER=
EMAIL_PASS=
# Railway blocks outbound Gmail SMTP (ETIMEDOUT). Prefer Resend HTTPS:
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Nexora OS <onboarding@resend.dev>  # or your verified domain sender


# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Slack (per-user OAuth + optional platform bot)
SLACK_MODE=live
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# User OAuth token (xoxp-) from Installed App Settings — search/admin/user-scoped APIs
SLACK_USER_TOKEN=
SLACK_OAUTH_REDIRECT_URI=http://localhost:4000/oauth/slack/callback
SLACK_VERIFICATION_TOKEN=
SLACK_DEFAULT_CHANNEL_ID=

# Notion
NOTION_MODE=live
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
# Must match Notion portal exactly. Local: http://localhost:4000/oauth/notion/callback
# Production: https://api.yourdomain.com/oauth/notion/callback (no trycloudflare quick tunnels)
NOTION_OAUTH_REDIRECT_URI=http://localhost:4000/oauth/notion/callback
# Verbose OAuth logs: start/callback/token exchange (never logs secrets)
OAUTH_DEBUG=false
# Dev-only paste Internal Integration secret (customers must use OAuth)
ALLOW_NOTION_TOKEN_PASTE=false

# Jira (Atlassian OAuth 2.0 3LO)
JIRA_MODE=live
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_OAUTH_REDIRECT_URI=http://localhost:4000/oauth/jira/callback
# Optional default project key (e.g. NEX). If empty, first accessible project is used.
JIRA_DEFAULT_PROJECT=

# Admin seed (used by npm run db:seed-admin)
ADMIN_SEED_EMAIL=aryavgaur1@gmail.com
ADMIN_SEED_PASSWORD=
